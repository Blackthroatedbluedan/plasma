# Firebase web config for KLFSapps inventory sync (project: gen-lang-client-0901687565)
# Copy to .env for local dev. Never commit secrets beyond public web API keys.

# --- Required for production KLFS sync ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0901687565
VITE_FIREBASE_APP_ID=

# --- Optional Firebase web config ---
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Callable region (default us-central1) ---
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# --- Local dev: mock callable (no Firebase network calls) ---
VITE_FIREBASE_MOCK=true

# --- Optional: Firebase Functions emulator ---
# VITE_FIREBASE_FUNCTIONS_EMULATOR=127.0.0.1:5001
